// This is your Prisma schema file
// Documentation: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Users table
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         UserRole
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  creator      Creator?
  professional Professional?
  subscriptions Subscription[]

  @@map("users")
}

enum UserRole {
  CREATOR
  PROFESSIONAL

  @@map("user_role")
}

// Subscription Plans
model SubscriptionPlan {
  id               String  @id @default(uuid())
  name             String  @unique
  priceMonthly     Decimal @map("price_monthly")
  priceYearly      Decimal? @map("price_yearly")
  maxProjectsMonth Int     @map("max_projects_month")
  aiCreditsMonth   Int     @map("ai_credits_month")
  features         Json?
  isActive         Boolean @default(true) @map("is_active")
  stripePriceIdMonthly  String? @map("stripe_price_id_monthly")
  stripePriceIdYearly   String? @map("stripe_price_id_yearly")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  subscriptions Subscription[]

  @@map("subscription_plans")
}

// Subscriptions
model Subscription {
  id            String             @id @default(uuid())
  userId        String             @map("user_id")
  planId        String             @map("plan_id")
  status        SubscriptionStatus
  projectsUsed  Int                @default(0) @map("projects_used")
  aiCreditsUsed Int                @default(0) @map("ai_credits_used")
  resetDate     DateTime           @map("reset_date")
  startedAt     DateTime           @map("started_at")
  expiresAt     DateTime?          @map("expires_at")
  billingCycle  String             @default("monthly") @map("billing_cycle") // monthly or yearly
  stripeCustomerId     String?     @map("stripe_customer_id")
  stripeSubscriptionId String?     @map("stripe_subscription_id")
  cancelAtPeriodEnd    Boolean     @default(false) @map("cancel_at_period_end")
  createdAt     DateTime           @default(now()) @map("created_at")

  // Relations
  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

// Creators
model Creator {
  id           String   @id @default(uuid())
  userId       String   @unique @map("user_id")
  companyName  String?  @map("company_name")
  projectCount Int      @default(0) @map("project_count")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Company information
  industry        String?   // Secteur d'activité
  companySize     String?   @map("company_size") // Taille entreprise (1-10, 11-50, 51-200, 200+)
  website         String?   // Site web
  description     String?   // Description de l'entreprise
  profilePictureUrl String? @map("profile_picture_url") // URL de la photo de profil

  // Contact information
  phone           String?   // Téléphone
  city            String?   // Ville
  country         String?   @default("France") // Pays

  // Project preferences
  typicalBudget       String?   @map("typical_budget") // Budget typique (< 1k, 1-5k, 5-10k, 10-50k, 50k+)
  preferredCreatives  Json      @default("[]") @map("preferred_creatives") // Types de créatifs recherchés

  // Social links
  linkedinUrl     String?   @map("linkedin_url")
  twitterUrl      String?   @map("twitter_url")

  // Relations
  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations       AiConversation[]
  notifications       CreatorNotification[]
  savedProfessionals  SavedProfessional[]

  @@map("creators")
}

// Professionals
model Professional {
  id                  String   @id @default(uuid())
  userId              String   @unique @map("user_id")
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  experienceYears     Int?     @map("experience_years")
  hourlyRate          Decimal? @map("hourly_rate")
  availability        String?
  bio                 String?
  profilePictureUrl   String?  @map("profile_picture_url")
  otherProfession     String?  @map("other_profession")
  isPremium           Boolean  @default(false) @map("is_premium")
  projectsCompleted   Int      @default(0) @map("projects_completed")
  projectsInProgress  Int      @default(0) @map("projects_in_progress")
  averageRating       Decimal? @map("average_rating")
  totalRatings        Int      @default(0) @map("total_ratings")
  responseRate        Int      @default(100) @map("response_rate")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // ===== NOUVEAUX CHAMPS POUR IA MATCHING =====

  // 1. Types de missions recherchées (prioritaire pour le matching)
  missionTypes        Json?     @map("mission_types")
  otherMissionType    String?  @map("other_mission_type")

  // 3. Préférences de projets
  preferredClientTypes    Json?     @map("preferred_client_types")
  preferredCollabTypes    Json?     @map("preferred_collab_types")
  minimumBudget           Decimal? @map("minimum_budget")

  // 4. Ce que le pro NE VEUT PAS faire (exclusions)
  exclusions              Json?     @map("exclusions")

  // Profil IA calculé (embeddings et metadata)
  profileEmbedding        String?  @map("profile_embedding") // JSON string des vecteurs
  profileCompleteness     Int      @default(0) @map("profile_completeness")
  lastAiAnalysis          DateTime? @map("last_ai_analysis")

  // Préférences de notifications
  notifyNewMatch          Boolean  @default(true) @map("notify_new_match")
  notifyMessage           Boolean  @default(true) @map("notify_message")
  notifyProjectUpdate     Boolean  @default(true) @map("notify_project_update")
  notifyEmail             Boolean  @default(true) @map("notify_email")

  // Relations
  user                      User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  professions               ProfessionalProfession[]
  softwareSkills            SoftwareSkill[]
  portfolios                Portfolio[]
  matches                   Match[]
  notifications             Notification[]
  savedBy                   SavedProfessional[]
  calendarEvents            CalendarEvent[]

  @@index([isPremium])
  @@index([availability])
  @@index([averageRating])
  @@index([profileCompleteness])
  @@map("professionals")
}

// Professions (métiers)
model Profession {
  id        String   @id @default(uuid())
  name      String   @unique
  category  String
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  professionals ProfessionalProfession[]

  @@map("professions")
}

// Professional Professions (many-to-many)
model ProfessionalProfession {
  id             String   @id @default(uuid())
  professionalId String   @map("professional_id")
  professionId   String   @map("profession_id")
  isPrimary      Boolean  @default(false) @map("is_primary")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  profession   Profession   @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([professionalId, professionId])
  @@index([professionalId])
  @@index([professionId])
  @@map("professional_professions")
}

// Software Skills (avec niveau détaillé pour IA)
model SoftwareSkill {
  id              String   @id @default(uuid())
  professionalId  String   @map("professional_id")
  softwareName    String   @map("software_name")
  proficiencyLevel String? @map("proficiency_level") // JUNIOR, CONFIRMED, SENIOR, EXPERT
  yearsOfUse      Int?     @map("years_of_use")
  createdAt       DateTime @default(now()) @map("created_at")

  // Relations
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([softwareName])
  @@index([proficiencyLevel])
  @@map("software_skills")
}

// Portfolios (enrichis pour IA)
model Portfolio {
  id             String   @id @default(uuid())
  professionalId String   @map("professional_id")
  title          String
  description    String?
  imageUrl       String?  @map("image_url")
  projectUrl     String?  @map("project_url")  // Lien externe (Behance, site perso, etc.)
  projectType    String?  @map("project_type")
  isFeatured     Boolean  @default(false) @map("is_featured")  // Projet mis en avant
  createdAt      DateTime @default(now()) @map("created_at")

  // ===== ENRICHISSEMENT PORTFOLIO POUR IA =====
  clientType     String?  @map("client_type")      // Startup, PME, Grand compte, Agence, etc.
  projectGoal    String?  @map("project_goal")     // Objectif du projet
  roleDescription String? @map("role_description") // Rôle exact du professionnel
  projectDuration String? @map("project_duration") // Ex: "2 semaines", "3 mois"
  projectImpact  String?  @map("project_impact")   // Résultat ou impact (optionnel)
  projectYear    Int?     @map("project_year")     // Année de réalisation

  // Analyse IA du projet
  aiAnalysis     Json?    @map("ai_analysis")      // Style détecté, techniques, qualité
  imageEmbedding String?  @map("image_embedding")  // Vecteur pour matching visuel

  // Relations
  professional Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  tags         PortfolioTag[]

  @@index([professionalId])
  @@index([projectType])
  @@index([clientType])
  @@map("portfolios")
}

// Portfolio Tags
model PortfolioTag {
  id          String   @id @default(uuid())
  portfolioId String   @map("portfolio_id")
  tag         String
  aiDetected  Boolean  @default(false) @map("ai_detected")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId])
  @@index([tag])
  @@map("portfolio_tags")
}

// AI Conversations
model AiConversation {
  id              String              @id @default(uuid())
  creatorId       String              @map("creator_id")
  status          ConversationStatus
  projectTitle    String?             @map("project_title")
  projectSummary  String?             @map("project_summary")
  messages        Json?
  projectInsights Json?               @map("project_insights")
  aiCreditsUsed   Int                 @default(0) @map("ai_credits_used")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  // Relations
  creator        Creator             @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  documents      GeneratedDocument[]
  matches        Match[]

  @@index([creatorId])
  @@index([status])
  @@map("ai_conversations")
}

enum ConversationStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED

  @@map("conversation_status")
}

// Generated Documents
model GeneratedDocument {
  id             String   @id @default(uuid())
  conversationId String   @map("conversation_id")
  docType        String   @map("doc_type")
  content        Json?
  fileUrl        String?  @map("file_url")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([docType])
  @@map("generated_docs")
}

// Matches
model Match {
  id              String        @id @default(uuid())
  conversationId  String        @map("conversation_id")
  professionalId  String        @map("professional_id")
  matchScore      Int           @map("match_score")
  reasoning       String?
  status          MatchStatus
  projectStatus   ProjectStatus @default(NOT_STARTED) @map("project_status")
  startedAt       DateTime?     @map("started_at")
  completedAt     DateTime?     @map("completed_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  // Relations
  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  professional Professional   @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  rating       Rating?

  @@index([conversationId])
  @@index([professionalId])
  @@index([matchScore])
  @@index([projectStatus])
  @@map("matches")
}

enum MatchStatus {
  PROPOSED
  CONTACTED
  ACCEPTED
  DECLINED

  @@map("match_status")
}

enum ProjectStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED

  @@map("project_status")
}

// Ratings (v2)
model Rating {
  id        String   @id @default(uuid())
  matchId   String   @unique @map("match_id")
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@index([rating])
  @@map("ratings")
}

// Messages between creators and professionals
model Message {
  id             String      @id @default(uuid())
  senderId       String      @map("sender_id")
  receiverId     String      @map("receiver_id")
  matchId        String?     @map("match_id")
  subject        String?
  content        String
  isRead         Boolean     @default(false) @map("is_read")
  createdAt      DateTime    @default(now()) @map("created_at")

  @@index([senderId])
  @@index([receiverId])
  @@index([matchId])
  @@index([isRead])
  @@map("messages")
}

// Notifications for professionals
model Notification {
  id              String           @id @default(uuid())
  professionalId  String           @map("professional_id")
  type            NotificationType
  title           String
  message         String
  matchId         String?          @map("match_id")
  isRead          Boolean          @default(false) @map("is_read")
  createdAt       DateTime         @default(now()) @map("created_at")

  // Relations
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  NEW_MATCH
  PROJECT_UPDATE
  MESSAGE_RECEIVED
  RATING_RECEIVED

  @@map("notification_type")
}

// Notifications for creators
model CreatorNotification {
  id          String                   @id @default(uuid())
  creatorId   String                   @map("creator_id")
  type        CreatorNotificationType
  title       String
  message     String
  link        String?                  // Optional link to navigate to
  isRead      Boolean                  @default(false) @map("is_read")
  createdAt   DateTime                 @default(now()) @map("created_at")

  // Relations
  creator     Creator @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@index([isRead])
  @@index([createdAt])
  @@map("creator_notifications")
}

enum CreatorNotificationType {
  MATCH_ACCEPTED        // Un pro a accepté le match
  MESSAGE_RECEIVED      // Nouveau message d'un pro
  PROJECT_COMPLETED     // Projet terminé
  CREDITS_LOW           // Crédits bas
  PROFILE_INCOMPLETE    // Rappel profil incomplet

  @@map("creator_notification_type")
}

// Saved Professionals (Favoris)
model SavedProfessional {
  id             String   @id @default(uuid())
  creatorId      String   @map("creator_id")
  professionalId String   @map("professional_id")
  note           String?  // Note personnelle du créateur
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  creator      Creator      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([creatorId, professionalId])
  @@index([creatorId])
  @@index([professionalId])
  @@map("saved_professionals")
}

// Calendar Events (manual events for professionals)
model CalendarEvent {
  id             String            @id @default(uuid())
  professionalId String            @map("professional_id")
  type           CalendarEventType
  title          String
  description    String?
  startDate      DateTime          @map("start_date")
  endDate        DateTime?         @map("end_date")
  isAllDay       Boolean           @default(true) @map("is_all_day")
  color          String?           // Hex color for display
  clientName     String?           @map("client_name") // For external missions
  budget         Decimal?          // For external missions
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  // Relations
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([startDate])
  @@index([endDate])
  @@index([type])
  @@map("calendar_events")
}

enum CalendarEventType {
  TIME_OFF        // Période off (vacances, indisponibilité)
  EXTERNAL_MISSION // Mission externe (pas sur JUNY)
  REMINDER        // Rappel personnel

  @@map("calendar_event_type")
}
