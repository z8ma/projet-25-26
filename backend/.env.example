# Database
DATABASE_URL="postgresql://user:password@localhost:5432/creative_match"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# OpenAI
OPENAI_API_KEY="sk-..."

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini AI
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Google Safe Browsing API (optional - for URL security checking)
# Get your API key at: https://console.cloud.google.com/apis/library/safebrowsing.googleapis.com
GOOGLE_SAFE_BROWSING_API_KEY=""

# Cloudinary (for image uploads)
# Get your credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google OAuth
# Get your credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# App
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Email configuration (SMTP)
# For Hostinger SMTP, use: smtp.hostinger.com, port 587
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="your-email@domain.com"
SMTP_PASS="your-email-password"
EMAIL_FROM="Your App Name <your-email@domain.com>"

# Redis Cache (Phase 5 - Optional but recommended for production)
# If not configured, will fallback to in-memory cache
REDIS_ENABLED="true"
USE_REDIS_CACHE="true"
REDIS_URL=""  # If set, overrides host/port/password (e.g., redis://localhost:6379)
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""
REDIS_DB="0"
