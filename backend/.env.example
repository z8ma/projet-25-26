# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# OpenAI
OPENAI_API_KEY="sk-..."

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini AI
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
