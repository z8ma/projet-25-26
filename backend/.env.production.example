# ================================
# FICHIER DE CONFIGURATION PRODUCTION
# ================================
# Copiez ce fichier en .env.production et remplissez avec vos vraies valeurs

# ================================
# DATABASE
# ================================
DATABASE_URL="postgresql://username:password@host:5432/database_name"
# Exemple Hostinger : postgresql://u123456_juny:motdepasse@localhost:5432/u123456_junydb

# ================================
# SERVER
# ================================
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://junyia.fr

# ================================
# JWT (JSON Web Token)
# ================================
# IMPORTANT: Générez un secret sécurisé unique !
# Vous pouvez utiliser: openssl rand -base64 32
JWT_SECRET=CHANGEZ_MOI_PAR_UN_SECRET_SECURISE

# ================================
# STRIPE (Paiements)
# ================================
# Utilisez vos clés LIVE pour la production
STRIPE_SECRET_KEY=sk_live_votre_cle_stripe_live
STRIPE_WEBHOOK_SECRET=whsec_votre_webhook_secret_live
STRIPE_PUBLISHABLE_KEY=pk_live_votre_cle_publique_live

# ================================
# OPENAI (API d'IA)
# ================================
OPENAI_API_KEY=sk-votre_cle_openai

# ================================
# ANTHROPIC (Claude AI)
# ================================
ANTHROPIC_API_KEY=sk-ant-votre_cle_anthropic

# ================================
# GOOGLE SAFE BROWSING (Sécurité)
# ================================
# Optionnel - Pour vérifier les liens malveillants
GOOGLE_SAFE_BROWSING_API_KEY=votre_cle_google_safe_browsing

# ================================
# EMAIL (Si vous utilisez un service d'email)
# ================================
# Exemple avec SendGrid, Mailgun, etc.
# EMAIL_SERVICE=sendgrid
# EMAIL_API_KEY=votre_cle_email
# EMAIL_FROM=noreply@junyia.fr

# ================================
# AUTRES CONFIGURATIONS
# ================================
# Ajoutez d'autres variables selon vos besoins
