# Production Environment Variables
# Copy this to .env.production and fill with actual values

# Database (use connection pooling in production)
DATABASE_URL="mysql://user:password@host:3306/database?connection_limit=10&pool_timeout=10"

# JWT (use strong secrets in production)
JWT_SECRET="CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"

# OpenAI
OPENAI_API_KEY="sk-..."

# Anthropic Claude
ANTHROPIC_API_KEY="sk-ant-..."

# Google Gemini AI
GEMINI_API_KEY="..."

# Stripe (use live keys in production)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Google Safe Browsing API
GOOGLE_SAFE_BROWSING_API_KEY="..."

# Cloudinary
CLOUDINARY_CLOUD_NAME="..."
CLOUDINARY_API_KEY="..."
CLOUDINARY_API_SECRET="..."

# App
PORT=3000
NODE_ENV="production"
FRONTEND_URL="https://yourdomain.com"

# Redis Cache (HIGHLY RECOMMENDED for production)
# Use a managed Redis instance (AWS ElastiCache, Redis Cloud, etc.)
REDIS_ENABLED="true"
USE_REDIS_CACHE="true"
REDIS_URL="redis://your-redis-instance.com:6379"  # Preferred method
# OR use individual settings:
# REDIS_HOST="your-redis-instance.com"
# REDIS_PORT="6379"
# REDIS_PASSWORD="your-redis-password"
# REDIS_DB="0"

# Monitoring & Logging (optional)
# LOG_LEVEL="info"
# SENTRY_DSN="https://..."
# DATADOG_API_KEY="..."
